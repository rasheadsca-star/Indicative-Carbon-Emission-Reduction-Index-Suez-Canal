{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ceri-sc",
  "main": "./worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
